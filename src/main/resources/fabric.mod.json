{
  "schemaVersion": 1,
  "name": "${mod_name}",
  "id": "${mod_id}",
  "version": "${mod_version}",
  "description": "${mod_description}",
  "authors": ["WinterWolfSV"],
  "contact": {
    "sources": "${repository}",
    "issues": "${repository}/issues",
    "homepage": "https://modrinth.com/mod/transferable-pets"
  },
  "license": "${license}",
